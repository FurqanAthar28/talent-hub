# ==================================================================
# Talent Hub frontend: example environment file
#
# HOW TO USE:
#   1) Copy it:   copy .env.example .env.local      (Windows)
#                 cp .env.example .env.local        (Mac/Linux)
#   2) Put your real values in .env.local
#   3) Restart "npm run dev" after changing it
#
# .env.local is in .gitignore, so it is never committed.
# ==================================================================

# Where Django runs. Only the SERVER part of Next.js reads this (the API
# proxy in app/api/backend/[...path]/route.ts). It has no NEXT_PUBLIC_
# prefix on purpose, so it is never sent to visitors' browsers.
# No trailing slash at the end!
# Production: https://your-backend-address (for example https://talenthub-api.onrender.com)
API_BASE_URL=http://localhost:8000

# Optional. How long the API proxy waits for Django before giving up
# (milliseconds). Default 30000 = 30 seconds.
# PROXY_TIMEOUT_MS=30000
