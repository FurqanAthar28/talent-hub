{
  // Settings for Pylance (the Python checker inside VS Code).
  // This file sits in the project root, so VS Code finds it by itself.

  // Check the Django code only. The frontend is TypeScript (checked separately).
  "include": ["Backend"],

  // Never check these:
  // - migrations: generated by Django, never edited by hand
  // - .venv: other people's packages, not our code
  "exclude": ["**/migrations", "**/__pycache__", "**/node_modules", "Backend/.venv", "Frontend"],

  // Use the packages installed in Backend/.venv (Django, DRF, and their type info).
  "venvPath": "Backend",
  "venv": ".venv",

  // Our imports start from the Backend folder ("from profiles.models import ...").
  "executionEnvironments": [{ "root": "Backend" }],

  // "standard" catches real mistakes. "strict" also complains about every
  // value Django/DRF don't describe fully, which gave thousands of
  // warnings that were not bugs.
  "typeCheckingMode": "standard",

  // Django's "class Meta:" inside serializers always triggers this rule,
  // even though it is the correct, documented way to write serializers.
  "reportIncompatibleVariableOverride": "none",

  // Django and DRF expose many attributes and types dynamically. These rules
  // otherwise report thousands of framework false positives while also
  // treating ordinary imports used by Django registration as unused.
  "reportUnusedImport": "none",
  "reportUnusedVariable": "none",
  "reportMissingParameterType": "none",
  "reportUnknownParameterType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownLambdaType": "none",
  "reportAttributeAccessIssue": "none",
  "reportArgumentType": "none",
  "reportIndexIssue": "none"
}
