# ==================================================================
# Talent Hub backend: example environment file
#
# HOW TO USE:
#   1) Copy it:      cp .env.example .env
#   2) Put your real values in .env
#   3) NEVER commit .env to Git (it must be in .gitignore)
#
# The values below WORK ON YOUR LAPTOP.
# Lines starting with "Production:" show what to use on the real site.
# ==================================================================


# ---------- 2. Core ----------
# Production: False
DJANGO_DEBUG=True

# Make a new key by running this in your terminal:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Use a DIFFERENT key on your laptop and in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Production: api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Address of Django's built-in admin site (developers only). Ends with "/".
# Production: something hard to guess, for example staff-7f3k2/
DJANGO_ADMIN_URL=admin/


# ---------- 4. Database ----------
DB_NAME=talent_hub
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Production (Render or another online database): require
DB_SSLMODE=require
# Seconds to reuse a database connection (0 = never reuse)
DB_CONN_MAX_AGE=60


# ---------- 5. Login tokens (JWT) ----------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SAMESITE=Lax

# These turn ON automatically when DJANGO_DEBUG=False.
# Only uncomment them if you need to force a value.
# JWT_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


# ---------- 6. Rate limits ----------
# How many login / code tries one email address may make.
# Format: number/period, where period is sec, min, hour or day.
AUTH_EMAIL_THROTTLE_RATE=10/min
# How many NEW accounts the whole site accepts (all visitors together).
SIGNUP_THROTTLE_RATE=30/hour
# Anti-spam, for each logged-in user.
CONNECTION_REQUEST_THROTTLE_RATE=40/hour
MESSAGE_THROTTLE_RATE=30/min


# ---------- 7. Frontend (Next.js) addresses ----------
# The address people type in the browser to open the website.
# No trailing slash at the end!
# Production: https://your-frontend-address (for example https://talenthub.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. If you leave it out, it copies CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------- 8. HTTPS (only used when DJANGO_DEBUG=False) ----------
# The defaults are right for Render. Uncomment only to change them.
# SECURE_SSL_REDIRECT=True
# TRUST_PROXY_SSL_HEADER=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False


# ---------- 11. Email ----------
# On your laptop, emails are printed in the terminal (no setup needed).
# To send REAL emails, uncomment the next line and fill in the rest.
# For Gmail, use an "App Password", not your normal password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sender@example.com
EMAIL_HOST_PASSWORD=replace-with-email-app-password
DEFAULT_FROM_EMAIL=sender@example.com
# The sender NAME people see in their inbox (Gmail shows it in bold).
# DEFAULT_FROM_EMAIL must be your real Gmail address when sending through Gmail.
EMAIL_SENDER_NAME=ProfessionalHub
EMAIL_TIMEOUT=10


# ---------- 12. One-time codes (OTP) ----------
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_OTP_EXPIRY_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5


# ---------- 12c. AI features ----------
# Get a key at https://console.anthropic.com. If you leave it empty, the app
# still works and the AI button says "AI is unavailable right now".
# OpenAI is used only for candidate headline and bio suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
# Which model writes the text. claude-haiku-5-5 is much cheaper.
AI_MODEL=claude-opus-5-5
# How many times one candidate may call the AI per day.
AI_DAILY_LIMIT=10


# ---------- 13. Logging ----------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
